# Copie para servico-risco/.env e preencha os valores locais. Nunca versione o .env.
# Gere a senha do PostgreSQL com: openssl rand -hex 16
# As URLs seguem o formato postgresql+psycopg://helmcare:SENHA@127.0.0.1:5433/<banco>
# (banco helmcare_risco no desenvolvimento e helmcare_risco_teste nos testes de integração).
# As demais variáveis RISCO_* têm valor padrão no app/config.py e no README.
POSTGRES_PASSWORD=
RISCO_DATABASE_URL=
RISCO_TESTES_DATABASE_URL=

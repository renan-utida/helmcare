        6
      ],
      "codificacao": {
        "0": "segunda",
        "1": "terça",
        "2": "quarta",
        "3": "quinta",
        "4": "sexta",
        "5": "sábado",
        "6": "domingo"
      },
      "descricao": "dia da semana da data local (0 = segunda, como o weekday() do Python)"
    },
    "mes": {
      "tipo": "inteiro",
      "faixa": [
        1,
        12
      ],
      "descricao": "mês da data local"
    },
    "feriado": {
      "tipo": "inteiro",
      "faixa": [
        0,
        1
      ],
      "descricao": "1 se a data local está em feriados.datas, 0 caso contrário"
    }
  },
  "conversaoRequisicao": {
    "rota": "POST /risco/v1/indice-turno",
    "passos": [
      "1. Ler inicio e fim da requisição (ISO 8601 em UTC, seção 2 do Contrato).",
      "2. Percorrer as horas cheias em UTC a partir do inicio arredondado para baixo, enquanto a hora começar antes do fim: cada hora que se sobrepõe ao turno entra.",
      "3. Converter o início de cada hora de UTC para America/Sao_Paulo (zoneinfo), que já trata o horário de verão.",
      "4. Montar hora, dia_semana, mes e feriado a partir da data e da hora locais.",
      "5. Prever cada hora com o modelo, com as colunas na ordem de ordemVariaveis.",
      "6. Calcular o componente de cada hora: min(100, arredondar(100 * previsao / p95)), com 0,5 para cima, usando o p95 de p95_sinistros_graves.json.",
      "7. Agregar as horas do turno num único componente sinistro (média, maior valor etc.): decisão da disciplina de SOA."
    ],

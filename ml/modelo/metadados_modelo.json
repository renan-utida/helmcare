  "arquivoModelo": "modelo_sinistros_xgb.json",
  "comoCarregar": "xgboost.Booster(); booster.load_model('modelo_sinistros_xgb.json'); booster.predict(xgboost.DMatrix(tabela_com_as_variaveis_na_ordem_abaixo))",
  "alvo": {
    "descricao": "quantidade esperada de sinistros graves com motocicletas na cidade de São Paulo em uma hora local",
    "definicaoSinistroGrave": "sinistro do Infosiga SP com pelo menos uma motocicleta e pelo menos uma vítima com lesão grave ou fatal",
    "unidade": "sinistros graves por hora (valor contínuo, maior ou igual a zero)",
    "tipoModelo": "XGBoost, regressão de contagem com objetivo count:poisson"
  },
  "ordemVariaveis": [
    "hora",
    "dia_semana",
    "mes",
    "feriado"
  ],
  "variaveis": {
    "hora": {
      "tipo": "inteiro",

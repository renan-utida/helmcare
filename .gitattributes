# Normaliza finais de linha no repositório
* text=auto

# Scripts e configurações que rodam no Linux precisam de LF
# (no Windows, CRLF quebra o Bash na VM Debian)
*.sh text eol=lf
*.service text eol=lf
*.conf text eol=lf

# Binários
*.png binary
*.jpg binary
*.pdf binary
*.zip binary
*.joblib binary
*.pkl binary

<Project>
  <!--
    Aplicado automaticamente a todos os projetos dentro de api/.
    Base: template do curso de C# do Prof. Cassiolato, mais GenerateDocumentationFile
    (igual ao ExpenseHub dos checkpoints), para os comentários XML aparecerem no Scalar.
    O TargetFramework é definido em cada .csproj (net10.0).
  -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>

    <!-- Nullable habilitado: avisos melhores e código mais seguro. -->
    <Nullable>enable</Nullable>

    <!-- Avisos não viram erro no build local, mas a meta da entrega é 0 avisos. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <!-- Nível de análise do template do professor. -->
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>

    <!-- Analisadores oficiais e regras do .editorconfig também no build. -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Gera o XML de documentação: todo membro público precisa de comentário ///. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Sem usings implícitos: cada arquivo declara o que usa. -->
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StyleCop.Analyzers"
                      Version="1.1.118"
                      PrivateAssets="all"
                      IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>
</Project>

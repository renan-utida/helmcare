# ==============================
# HelmCare - .gitignore
# Cobre C#/.NET, Python, Node/Expo e arquivos de sistema
# ==============================

# Sistema operacional
.DS_Store
Thumbs.db
desktop.ini

# Editores e IDEs
.vs/
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Variáveis de ambiente e segredos (nunca versionar)
.env
.env.*
!.env.example
*.pem
*.key
appsettings.Local.json
appsettings.*.local.json

# C# / .NET (api/)
bin/
obj/
*.user
*.suo
TestResults/
*.db
*.db-shm
*.db-wal

# Python (servico-risco/, ml/, cyber/)
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/
*.egg-info/
.coverage
htmlcov/

# Node / Expo (mobile/)
node_modules/
.expo/
dist/
web-build/
expo-env.d.ts
npm-debug.*
yarn-error.*
*.jks
*.p8
*.p12
*.mobileprovision

# Dados brutos de ML (pesados): baixar conforme ml/dados/README.md
ml/dados/brutos/*
!ml/dados/brutos/.gitkeep
*.zip

# Logs locais (as evidências do OS ficam em infra/evidencias/ e são versionadas)
*.log
logs/
!infra/evidencias/**